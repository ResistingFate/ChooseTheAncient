<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Keep test project files out of the Godot/mod project item graph. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);packages/**;tests/**</DefaultItemExcludes>
        
        <PublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>

        <!-- These let the test project reference this project without copying/publishing the mod. -->
        <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
        <PublishModPck Condition="'$(PublishModPck)' == ''">true</PublishModPck>
        <SkipModDeploy Condition="'$(SkipModDeploy)' == ''">false</SkipModDeploy>
        <SkipDependencyPathCheck Condition="'$(SkipDependencyPathCheck)' == ''">false</SkipDependencyPathCheck>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <PathMap>$(MSBuildProjectDirectory)=.\</PathMap>
    </PropertyGroup>

    <!-- OS Detection -->
    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <!-- NOTE: MegaDot is version 4.5.1, and the game won't load your .pck if the Godot version used is newer. -->

    <!-- Windows -->
    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <AutoSteamPath>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>

        <GodotPath>$(UserProfile)//Downloads/megadot-4.5.1-m.14/MegaDot_v4.5.1-stable_mono_win64.exe</GodotPath>
        <!-- If on Windows and Slay the Spire 2 is not installed in your default steam library, adjust the following.-->
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps</SteamLibraryPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- Linux -->
    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(SteamLibraryPath)/common/Godot Engine/godot.x11.opt.tools.64</GodotPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- macOS -->
    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Let tests call internal helper/core methods without making them public API. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>ChooseTheAncient.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <!-- Deals with an error related to BepInEx.AssemblyPublicizer.MSBuild. -->
        <Compile Remove="**/*.uid" />
        <None Remove="**/*.uid" />
        <AdditionalFiles Remove="**/*.uid" />

        <!-- Godot/resource folders are not C# source. -->
        <Compile Remove="mod_page_resources\**" />
        <Compile Remove="ChooseTheAncient\**" />
        <Compile Remove="materials\**" />
        <Compile Remove="shaders\**" />
        <Compile Remove="images\**" />

        <EmbeddedResource Remove="ChooseTheAncient\**" />
        <EmbeddedResource Remove="materials\**" />
        <EmbeddedResource Remove="shaders\**" />
        <EmbeddedResource Remove="images\**" />

        <!-- Keep tests completely out of the shipped mod project. -->
        <Compile Remove="tests\**" />
        <EmbeddedResource Remove="tests\**" />
        <None Remove="tests\**" />
        <Content Remove="tests\**" />
    </ItemGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>true</Private>
            <Publicize>False</Publicize> <!--Allows private/protected field references but may cause errors.-->
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
        <AdditionalFiles Include="ChooseTheAncient/localization/**/*.json" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="RitsuLib.ModSettingsMirror.Mod.ChooseTheAncient.DisableSources" Value="baselib,modconfig" />
        <AssemblyMetadata Include="RitsuLib.ModSettingsInterop.ProviderType" Value="ChooseTheAncient.Scripts.RitsuLibModSettingsInteropProvider" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore" />
        <None Include="ChooseTheAncient.json" />
        <None Include="project.godot" />
        <None Include="ChooseTheAncient\**"
              Exclude="ChooseTheAncient\bin\**;ChooseTheAncient\obj\**" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="scenes\mod\choose_the_ancient\choose_the_ancient_choice_card.tscn" />
        <Content Include="scenes\mod\choose_the_ancient\choose_the_ancient_selection_screen.tscn" />
        <Content Include="scenes\mod\choose_the_ancient\ancient_dialogue_line.tscn" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error
                Text="Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(SkipDependencyPathCheck)' != 'true' and ('$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)'))" />

        <Error
                Text="Godot not found at path '$(GodotPath)'"
                Condition="'$(SkipDependencyPathCheck)' != 'true' and ('$(GodotPath)' == '' or !Exists('$(GodotPath)'))" />
    </Target>

    <Target Name="CopyToModsFolderOnBuild"
            AfterTargets="PostBuildEvent"
            Condition="'$(CopyModOnBuild)' == 'true'
                       and '$(SkipModDeploy)' != 'true'
                       and '$(DesignTimeBuild)' != 'true'">
        <Message Text="Copying ChooseTheAncient .dll and manifest to mods folder." Importance="high" />

        <MakeDir Directories="$(ModsPath)$(MSBuildProjectName)" />

        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"
              Condition="Exists('$(TargetPath)')" />

        <Copy SourceFiles="ChooseTheAncient.json"
              DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"
              Condition="Exists('ChooseTheAncient.json')" />

        <Copy SourceFiles="$(TargetDir)$(MSBuildProjectName).pdb"
              DestinationFiles="$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pdb"
              Condition="Exists('$(TargetDir)$(MSBuildProjectName).pdb')" />
    </Target>

    <Target Name="GodotPublish"
            AfterTargets="Publish"
            Condition="'$(PublishModPck)' == 'true'
                       and '$(SkipModDeploy)' != 'true'
                       and '$(GodotPath)' != ''
                       and Exists('$(GodotPath)')
                       and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder." Importance="high" />

        <MakeDir Directories="$(ModsPath)$(MSBuildProjectName)" />

        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue" />
    </Target>

    <Target Name="GodotPublishSkipped"
            AfterTargets="Publish"
            Condition="'$(PublishModPck)' == 'true'
                       and '$(SkipModDeploy)' != 'true'
                       and ('$(GodotPath)' == '' or !Exists('$(GodotPath)'))">
        <Message Text="Skipping Godot .pck export because GodotPath is not configured." Importance="high" />
    </Target>
</Project>